# Copy to .env (never commit .env)

# Amazon Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5

# LangSmith tracing (free account at smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=paste-your-key-here
LANGSMITH_PROJECT=isp-support-agent

# FiberLab
FIBERLAB_DB=data/fiberlab.db
FIBERLAB_SESSION_SECRET=change-me-to-a-long-random-string
